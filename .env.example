# Public
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43177

# WhatsApp deep link (digits only, country code included, no +). Leave blank to hide WhatsApp CTAs.
# Example for South Africa: 27821234567
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Contact form delivery (optional for local demo)
# Without these, POST /api/contact still succeeds and logs the brief — useful for local preview.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Two Element Media <onboarding@resend.dev>"
RESEND_API_KEY=
